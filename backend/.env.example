# Use the same OAuth 2.0 Web client ID configured for frontend/.env.local.
GOOGLE_CLIENT_ID=replace

# Google Identity Services sends a signed ID token; a client secret is not used.

# Generate a random secret with at least 32 characters. Never commit the real value.
SESSION_SECRET=replace

# Comma-separated admin addresses; only these emails can receive admin role.
ADMIN_EMAILS=adminVD@unklab.ac.id,12410292@student.unklab.ac.id

# Store the output of auth.hash_password(), never the plaintext admin password.
ADMIN_PASSWORD_HASH=replace

# Set COOKIE_SECURE=true behind HTTPS in deployment.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
FRONTEND_URL=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SMTP account for student password-reset emails. For Gmail, use an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Generate a Fernet key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep the key secret and backed up; losing it makes uploaded files unrecoverable.
DOCUMENT_ENCRYPTION_KEY=replace with your encryp
# Optional private directory for encrypted uploads (not served by the web app).
# DOCUMENT_STORAGE_DIR=
