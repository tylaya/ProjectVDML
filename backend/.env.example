# Use the same OAuth 2.0 Web client ID configured for frontend/.env.
GOOGLE_CLIENT_ID=replace-with-google-oauth-web-client-id

# Generate a random secret with at least 32 characters. Never commit the real value.
SESSION_SECRET=replace-this-with-a-random-secret-at-least-32-characters

# Comma-separated verified Google addresses allowed into the staff/admin area.
ADMIN_EMAILS=staff@example.unklab.ac.id

# Set COOKIE_SECURE=true behind HTTPS in deployment.
COOKIE_SECURE=false
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
